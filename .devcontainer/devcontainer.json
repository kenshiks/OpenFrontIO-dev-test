{
  "name": "OpenFront.io Dev",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "forwardPorts": [9000],
  "portsAttributes": {
    "9000": {
      "label": "OpenFront (client + server)",
      "onAutoForward": "openBrowser"
    }
  },
  // npm ci --ignore-scripts, per this repo's convention (see CLAUDE.md) —
  // do not swap for "npm install".
  "postCreateCommand": "npm run inst",
  // VITE_HOST=lan binds the client dev server to 0.0.0.0 instead of just
  // localhost, which port forwarding needs to reach it from outside the
  // container. Backgrounded with nohup so it survives postStartCommand's
  // shell exiting; logs land in /tmp for troubleshooting.
  "postStartCommand": "nohup npm run dev:host > /tmp/openfront-dev.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
